# Template for .env.bootstrap.tf (git-ignored, mode 600). Read only by the
# bootstrap root and by `task tf:ovh`.
#
# The OVH account API credential can act on the whole account. The bootstrap
# root is the only root that creates account-level resources, so it is the
# only one that sees these values.

# OVH API credentials. Mint once with `ovhcloud login` or the createToken page.
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# Public Cloud project ID, state bucket name, and region. The region
# is uppercase, as the project API expects it. Pick a 3-AZ region.
OVH_CLOUD_PROJECT_SERVICE=
OVH_BUCKET=
OVH_REGION=
