# Template for .env.account.ovh.tf (git-ignored, mode 600). Read only by
# the bootstrap root and by `task ovh:cli`.
#
# The credential can act on the whole OVH account. Keep it out of tracked
# files, shell history, and tickets.

# OVH API credentials. Mint once with `ovhcloud login` or the createToken
# page.
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# Public Cloud project ID. Feeds the ovhcloud CLI and the tofu variable
# project_id.
OVH_CLOUD_PROJECT_SERVICE=
