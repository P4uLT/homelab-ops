# Template for .env.tf (git-ignored, mode 600). Read by the tf:* tasks
# through Task's dotenv, never by the shared environment: a task may run
# third-party code (the Packer plugin, the OpenTofu providers, the tflint
# plugins, the Galaxy roles), and none of it needs these.
#
# This file holds what every OpenTofu task needs, under the native names
# of its consumer: TF_VAR_* for tofu, AWS_* for the S3 backend.

# State encryption passphrase, 16 characters minimum. Also lives in the
# off-site recovery kit.
TF_VAR_state_passphrase=
# S3 credentials for the state bucket, printed once by the bootstrap
# apply. The backend reads the AWS_* names.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# State bucket. The bootstrap root created it once. Every other root
# points its backend at it.
TF_VAR_bucket_name=
