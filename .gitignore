# Generated Ansible runtime files
ansible/config/tmp/*
!ansible/config/tmp/.gitkeep

# Downloaded vendor content; keep the empty path visible
ansible/roles/vendors/*
!ansible/roles/vendors/.gitkeep
ansible/collections/vendors/*
!ansible/collections/vendors/.gitkeep

# Local agent tooling lockfile — not repo content
skills-lock.json
