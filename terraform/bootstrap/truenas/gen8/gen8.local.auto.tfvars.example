truenas_host    = "nas.example.invalid"
truenas_api_key = "replace-locally"
# truenas_ca_cert = "/path/to/management-ca.pem"
disk_serials = ["DRIVE-A", "DRIVE-B", "DRIVE-C", "DRIVE-D"]

services = {
  nfs  = true
  cifs = true # SMB
}

provision_smb_shares = false

# For the multiprotocol image library, set provision_smb_shares to true.
