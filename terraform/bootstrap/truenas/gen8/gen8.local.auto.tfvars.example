truenas_host    = "nas.example.invalid"
truenas_api_key = "replace-locally"
# truenas_ca_cert = "/path/to/management-ca.pem"

  pool = {
    # Defaults: name "tank", layout "RAIDZ2" over all listed serials.
    # layout = "MIRROR" # Or RAIDZ. Two or three disks minimum.
    serials = ["DRIVE-A", "DRIVE-B", "DRIVE-C", "DRIVE-D"]
  }

services = {
  nfs  = true
  cifs = true # SMB
}

provision_smb_shares = false

# For the image library and the backup share, set provision_smb_shares
# to true. Enable the two ACL flags below. Uncomment the accounts and
# groups, and set a password for each SMB account.
# groups = {
#   smb_users      = { name = "smb-users", smb = true } # No dataset grants.
#   iso_publishers = { name = "iso-publishers", smb = true }
# }
# users = {
#   iso_publisher = {
#     username          = "iso-publisher"
#     full_name         = "Image library publisher"
#     primary_group     = "smb_users"
#     additional_groups = ["iso_publishers"]
#     smb               = true
#   }
#   pve_iso_reader = {
#     username      = "pve-iso-reader"
#     full_name     = "Proxmox ISO storage reader"
#     primary_group = "smb_users"
#     smb           = true
#   }
#   ha_backup_writer = {
#     username      = "ha-backup-writer"
#     full_name     = "Home Assistant backup writer"
#     primary_group = "smb_users"
#     smb           = true
#   }
# }
# user_passwords = {
#   iso_publisher    = "replace-locally"
#   pve_iso_reader    = "replace-locally"
#   ha_backup_writer  = "replace-locally"
# }

# Enables filesystem ACL management from the storage root. Not scoped to a dataset.
# provision_dataset_acls = true

# Account read access for named identities in dataset ACLs and NFS mappings.
# provision_group_lookup = true

# The apps-subsystem roles for the RustFS application. Apply this root after
# enabling the gate, before the storage root plans the application.
# provision_apps = true

# Enable issuance before changing any application or administration binding.
# The NAS keeps the TLS keys across renewals.
# acme_enabled = true
# acme = {
#   name_prefix  = "truenas" # Label in TrueNAS, not a DNS name.
#   ovh_endpoint = "ovh-eu"
#   accept_terms = true
# }
# acme_certificates = [
#   {
#     name        = "shared"
#     common_name = "nas.example.net"
#     san         = ["*.apps.example.net"]
#   },
# ]
# The common name also becomes a subject alternative name.
# acme_ovh_credentials = {
#   application_key    = "replace-locally"
#   application_secret = "replace-locally"
#   consumer_key       = "replace-locally"
# }
# Increment this value when replacing the OVH credentials.
# acme_ovh_credentials_version = 1

# To use an existing DNS authenticator instead, set acme.dns_authenticator_id
# to its positive numeric ID. Omit acme.ovh_endpoint and acme_ovh_credentials.

# Bind the administration certificate only after checking both chains and the
# endpoint hostname. The change restarts the web server.
# acme_admin_certificate_name = "shared"
