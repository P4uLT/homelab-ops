truenas_host    = "nas.example.invalid"
truenas_api_key = "replace-locally"
# truenas_ca_cert = "/path/to/management-ca.pem"

  pool = {
    # Defaults: name "tank", layout "RAIDZ2" over all listed serials.
    # layout = "MIRROR" # Or RAIDZ. Two or three disks minimum.
    serials = ["DRIVE-A", "DRIVE-B", "DRIVE-C", "DRIVE-D"]
  }

services = {
  nfs  = true
  cifs = true # SMB
}

provision_smb_shares = false

# For the image library and the backup share, set provision_smb_shares
