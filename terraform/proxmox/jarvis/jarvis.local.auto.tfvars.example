# Template for jarvis.local.auto.tfvars (git-ignored, mode 600). Tofu
# loads it in this root. The token comes from the access root, run
# once: see docs/runbooks/bootstrap-pve-access.md.

pve_endpoint  = "https://<address>:8006/"
pve_api_token = "terraform-prov@pve!tf=<secret>"

# One entry per workload, keyed by hostname. The template is the volid of the
# Packer chain the container clones: NAS:vztmpl/<artifact>. An entry without
# ipv4 stays on DHCP, where the address can move on a reboot, and ct_ipv4 only
# fills once the container reports a lease.
#
# cpu, ram, swap, and disk are optional: leaving them out keeps the module's
# defaults.
lxc_workloads = {
  example = {
    id       = 1000
    template = "NAS:vztmpl/<artifact>"
    # Mount point sizes need a unit, unlike the numeric root disk size.
    # mountpoints = [{ volume = "local-lvm", path = "/srv/data", size = "10G", backup = true }]
  }
}

# VM image pins manage their own lifecycle, independent of workloads.
# PVE downloads missing images. OpenTofu imports matching existing files.
# Removing a pin makes OpenTofu delete its PVE file.
# Replace IMAGE_STORAGE with a PVE datastore that allows ISO content.
# vm_image_downloads = {
#   haos = {
#     url       = "https://github.com/home-assistant/operating-system/releases/download/18.3/haos_ova-18.3.qcow2.xz"
