---
# Generated by OpenTofu from terraform/proxmox/${node}. Never edited by hand:
# the next apply rewrites the file.
# Groups and container ids only. An address is a secret, and it lives in the
# group's secrets.sops.yaml.
all:
  children:
    grp_servers:
      children:
        grp_tf:
          children:
%{ for name in sort(keys(workloads)) ~}
            grp_tf_${replace(name, "-", "_")}:
              hosts:
                ${name}:
                  proxmox_vmid: ${workloads[name].id}
%{ endfor ~}
