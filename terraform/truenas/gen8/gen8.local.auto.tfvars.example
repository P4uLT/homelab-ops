# Copy this file to gen8.local.auto.tfvars and restrict it to your user.
# Replace NAS_HOST and PROVISIONING_API_KEY. Use the terraform-prov key,
# not the administrator key. Create the matching identities from the
# bootstrap example. Enable SMB shares, dataset ACLs, and group lookup
# there. Start SMB before planning.
# Follow docs/runbooks/truenas-proxmox-iso-library.md and
# docs/runbooks/truenas-home-assistant-backups.md for the two shares.
# For an NFS export, see docs/runbooks/truenas-share-nfs.md or
# docs/runbooks/truenas-share-multiprotocol.md.

truenas_host    = "NAS_HOST"
truenas_api_key = "PROVISIONING_API_KEY"
# truenas_ca_cert = "/path/to/management-ca.pem"

datasets = {
  # People publish images over SMB. The Proxmox reader account reads.
  iso = {
    name        = "tank/iso"
    share_type  = "SMB"
    recordsize  = "1M"
    compression = "lz4"
    filesystem_acl = {
      preset = "nfs4_access"
      groups = { "iso-publishers" = "MODIFY" }
      users  = { "pve-iso-reader" = "READ" }
    }
    smb = {
      name      = "iso"
      purpose   = "DEFAULT_SHARE"
      browsable = true
      ro        = false
    }
  }

  # Home Assistant writes and prunes its own backups over SMB.
  ha_backups = {
    name        = "tank/ha-backups"
    share_type  = "SMB"
    recordsize  = "1M"
    compression = "lz4"
    filesystem_acl = {
      preset = "nfs4_access"
      users  = { "ha-backup-writer" = "MODIFY" }
    }
    smb = {
      name      = "ha-backups"
      purpose   = "DEFAULT_SHARE"
      browsable = false
      ro        = false
    }
  }

  # SMB only. Create the reader and editor groups and add the SMB users.
  # documents = {
  #   name       = "tank/documents"
  #   share_type = "SMB"
  #   filesystem_acl = {
  #     preset = "nfs4_access"
  #     groups = {
  #       "documents-readers" = "READ"
  #       "documents-editors" = "MODIFY"
  #     }
  #   }
  #   smb = {
  #     name      = "documents"
  #     purpose   = "DEFAULT_SHARE"
  #     browsable = true
  #     ro        = false
  #   }
  # }

  # NFS only. Create BACKUP_USER and BACKUP_GROUP. Grant the backup identity
  # write and traverse access. See docs/runbooks/truenas-share-nfs.md.
  # backups = {
  #   name = "tank/backups"
  #   nfs = {
  #     hosts        = ["NFS_CLIENT"]
  #     mapall_user  = "BACKUP_USER"
  #     mapall_group = "BACKUP_GROUP"
  #     ro           = false
  #   }
  # }

  # Application data with no share.
  # appdata = {
  #   name       = "tank/appdata"
  #   share_type = "APPS"
  # }

  # RustFS data. The RustFS application below mounts this dataset at
  # /mnt/tank/rustfs. Create it before turning the application on.
  # rustfs = {
  #   name       = "tank/rustfs"
  #   share_type = "APPS"
  # }
}

# The one application on this NAS. Read the offered chart version from the
# TrueNAS catalog before the first apply. Keep it pinned: an upgrade is a
# deliberate change.
# The text plan masks the application values. This file still holds the
# access key and the secret key, so restrict it to your user.
# Turning the gate off after install plans the application's removal.
# rustfs_app_enabled        = true
# rustfs_app_version        = "1.1.47"
# rustfs_app_dataset        = "tank/rustfs"
# rustfs_app_api_port       = 30292
# rustfs_app_web_port       = 30293
# Use the bootstrap acme_apps_certificate_id for the managed wildcard.
# rustfs_app_certificate_id = 1
# TrueNAS publishes the API on every interface. Restrict the port in the
# NAS firewall to the operator and Talos networks.
# rustfs_app_access_key     = "RUSTFS_ACCESS_KEY"
# rustfs_app_secret_key     = "RUSTFS_SECRET_KEY"
