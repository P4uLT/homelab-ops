truenas_host    = "nas.example.invalid"
truenas_api_key = "replace-locally"
# truenas_ca_cert = "/path/to/management-ca.pem"

datasets = {
  # Multiprotocol ISO library: Windows uploads, Proxmox reads and writes.
  iso = {
    name        = "tank/iso"
    acltype     = "nfsv4"
    share_type  = "MULTIPROTOCOL"
    recordsize  = "1M"
    compression = "lz4"
    filesystem_acl = {
      preset      = "nfs4_group_rw_others_ro"
      group_names = ["smb-users"] # Needs provision_group_lookup.
    }
    nfs = {
      hosts   = ["pve.example.invalid"] # TrueNAS must resolve it. networks also works.
      comment = "Proxmox VE ISO library"
      ro      = false
    }
    smb = {
      name      = "iso"
      purpose   = "MULTIPROTOCOL_SHARE"
      browsable = true
      ro        = false
    }
  }

  # SMB-only documents, read-only for the SMB group.
  # documents = {
  #   name = "tank/documents"
  #   smb = {
  #     name      = "documents"
  #     purpose   = "DEFAULT_SHARE"
  #     browsable = true
  #     ro        = true
  #   }
  # }

  # NFS-only backups.
  # backups = {
  #   name = "tank/backups"
  #   nfs  = { hosts = ["192.0.2.10"] }
  # }

  # Local app data, no share.
  # appdata = {
  #   name = "tank/appdata"
  # }
}
