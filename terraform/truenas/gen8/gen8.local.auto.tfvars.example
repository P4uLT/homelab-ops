# Copy this file to gen8.local.auto.tfvars and restrict it to your user.
# Replace NAS_HOST, BOOTSTRAP_API_KEY, NFS_CLIENT, and SMB_GROUP.
# The provisioning key goes in terraform/truenas/gen8/gen8.local.auto.tfvars.
# The NFS and SMB services must run: a share plan checks them.

truenas_host    = "NAS_HOST"
truenas_api_key = "BOOTSTRAP_API_KEY"
# truenas_ca_cert = "/path/to/management-ca.pem"

datasets = {
  # Windows and Proxmox share this image library.
  iso = {
    name        = "tank/iso"
    share_type  = "MULTIPROTOCOL"
    acltype     = "nfsv4" # Only needed when an existing dataset reports "inherit".
    recordsize  = "1M"
    compression = "lz4"
    filesystem_acl = {
      preset      = "nfs4_group_rw_others_ro"
      group_names = ["SMB_GROUP"] # Needs provision_group_lookup.
    }
    nfs = {
      hosts   = ["NFS_CLIENT"]
      comment = "Proxmox VE image library"
      ro      = false
    }
    smb = {
      name      = "iso"
      purpose   = "MULTIPROTOCOL_SHARE"
      browsable = true
      ro        = false
    }
  }

  # Windows only. Grant SMB_GROUP access in the dataset ACL.
  # documents = {
  #   name       = "tank/documents"
  #   share_type = "SMB"
  #   smb = {
  #     name      = "documents"
  #     purpose   = "DEFAULT_SHARE"
  #     browsable = true
  #     ro        = true
  #   }
  # }

  # NFS only. Replace hosts with networks to authorize a subnet.
  # backups = {
  #   name = "tank/backups"
  #   nfs  = { hosts = ["NFS_CLIENT"] }
  # }

  # Application data with no share.
  # appdata = {
  #   name       = "tank/appdata"
  #   share_type = "APPS"
  # }
}
