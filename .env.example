# homelab-ops environment — copy to .env (git-ignored) and fill in.
# Every variable here is scaffolding. Real consumers arrive with their phase.

# SOPS / age (SOPS bootstrap phase, see docs/sops.md)
# NOTE: SOPS_AGE_KEY_FILE is set in the committed mise.toml via
# {{ config_root }} (cwd-proof absolute path). An .env value here applies
# only as an override for other tools, not for mise-launched commands.
SOPS_AGE_KEY_FILE=.age.key.txt

# OpenTofu / OVH (state backend, see terraform/BACKEND.md)
# OVH API credentials. Mint once with `ovhcloud login` or the createToken page.
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# Public Cloud project ID, state bucket name, and region. The region
# is uppercase, as the project API expects it. Pick a 3-AZ region.
OVH_CLOUD_PROJECT_SERVICE=
OVH_BUCKET=
OVH_REGION=
# State encryption passphrase, 16 characters minimum. Also lives in the
# off-site recovery kit.
TF_STATE_PASSPHRASE=
# S3 credentials for the state bucket. Printed once by the bootstrap apply.
OVH_S3_ACCESS_KEY=
OVH_S3_SECRET_KEY=
