# Template for .env (git-ignored, mode 600). mise loads this file for every
# task, so it holds only what every task may see. Anything a single task
# needs belongs in that task's dotenv file instead, such as .env.tf.

# SOPS / age (see docs/sops.md)
# NOTE: SOPS_AGE_KEY_FILE is set in the committed mise.toml via
# {{ config_root }} (cwd-proof absolute path). An .env value here applies
# only as an override for other tools, not for mise-launched commands.
SOPS_AGE_KEY_FILE=.age.key.txt

# Packer / PVE golden images: no Packer variable lives here. The node
# address, the login, and the key sit in the git-ignored per-node file
# packer/hosts/<node>.local.pkrvars.hcl. See
# docs/runbooks/build-base-image.md.
