---
# YAML style for the shell. ansible-lint applies this file to playbooks
# and role content it lints.
extends: default

rules:
  comments:
    min-spaces-from-content: 1
  # Required by ansible-lint (see docs for the yaml rule)
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  line-length:
    max: 120
  truthy:
    check-keys: false
