---
# YAML style for the shell. ansible-lint applies this file to playbooks
# and role content it lints.
extends: default

# Encrypted group secrets carry a `mac:` value that cannot wrap, so line
# length can never pass on them. Both ansible-lint and the editor read this
# file, and neither has anything to say about a ciphertext blob.
ignore: |
  inventory/*/group_vars/*/*.sops.yaml

rules:
  comments:
    min-spaces-from-content: 1
  # Required by ansible-lint (see docs for the yaml rule)
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  line-length:
    max: 120
  truthy:
    check-keys: false
